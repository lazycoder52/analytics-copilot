# analytics-copilot environment configuration
# Copy this file to .env (which is gitignored) or set environment variables directly.

# LLM provider selection: gemini | openai_compatible | ollama | mock
COPILOT_LLM_PROVIDER=mock

# Model identifier (optional; defaults per provider:
# gemini -> gemini-3.1-flash-lite-preview, openai_compatible -> gpt-4o-mini,
# ollama -> qwen2.5-coder:7b, mock -> mock-sql-v1)
COPILOT_LLM_MODEL=

# Provider credentials and endpoints (never commit real keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_HOST=http://localhost:11434

# Optional path overrides
# COPILOT_DATA_DIR=data
# COPILOT_CACHE_DIR=evals/cache
